# Branding
VITE_APP_NAME=Oath of Care

# Supabase public client configuration
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_SUPABASE_PUBLISHABLE_KEY=

# OAuth public client identifiers (provider secrets belong server-side)
VITE_GOOGLE_OAUTH_CLIENT_ID=
VITE_FACEBOOK_APP_ID=

# Server-side password verification challenge API. Must issue, validate,
# rate-limit, expire, and invalidate email codes before password updates.
VITE_SECURITY_API_BASE=

# Java Spring Boot API (for local development, usually http://localhost:8080/api/v1)
VITE_API_BASE_URL=

# Web-only Maps key. Never reuse the Android Maps key.
VITE_GOOGLE_MAPS_WEB_KEY=

# Optional hosted showcase video
VITE_SHOWCASE_VIDEO_URL=

# Development-only adapters. Never enable mock data in production.
VITE_USE_MOCK_DATA=false
VITE_DEMO_APPLICATION_STATUS=UNDER_REVIEW
